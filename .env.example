# Copy to .env and fill in values. Used by docker compose and local dev.
#
# Database — must be reachable from the machine running `next dev` (not a curl/Postman bug).
# If you see: "Can't reach database server at `db.prisma.io:5432`" or POST /api/auth/signup → 500,
# fix DATABASE_URL: use local Postgres below, or a Neon/Supabase URL that allows your IP.
# Remote Prisma/Postgres hosts require network access, correct credentials, and sslmode if required.
DATABASE_URL="postgresql://pixora:pixora@localhost:5432/pixora"

# Auth
JWT_SECRET="your-secret-key"

# App URL (for redirects, Stripe, etc.)
NEXT_PUBLIC_URL="http://localhost:3000"
# Published funnel URLs use {subDomainName}.{NEXT_PUBLIC_DOMAIN} (default in code: pawal.dev if unset).
NEXT_PUBLIC_DOMAIN="localhost:3000"

# Optional: Gmail (contact form, invites)
# GMAIL_USER=
# GMAIL_APP_PASSWORD=

# Optional: Stripe
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# NEXT_PUBLIC_STRIPE_CLIENT_ID=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# Optional: protect /api/funnel-tools/* in production (Postman: x-funnel-tools-secret)
# FUNNEL_TOOLS_SECRET=

# Optional: Clerk
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# CLERK_SECRET_KEY=

# Optional: Pusher
# PUSHER_APP_ID=
# NEXT_PUBLIC_PUSHER_KEY=
# PUSHER_SECRET=
# NEXT_PUBLIC_PUSHER_CLUSTER=
