                  "pm.test('TC06 JSON error body', () => pm.expect(pm.response.headers.get('content-type')||'').to.match(/json/i));",
                  "pm.test('TC07 error mentions auth', () => { const j = pm.response.json(); pm.expect(j).to.have.property('error'); });"
