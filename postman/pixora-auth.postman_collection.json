{
  "info": {
    "name": "Pixora Auth API",
    "_postman_id": "pixora-auth-collection",
    "description": "Authentication + create agency (multipart). Signup/Signin save {{token}}; Create agency saves {{agencyId}}. POST /api/agency requires Bearer JWT and user without an existing agency.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "token", "value": "" },
    { "key": "agencyId", "value": "" }
  ],
  "item": [
    {
      "name": "Signup",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "try {",
              "  var j = pm.response.json();",
              "  if (j.token) pm.collectionVariables.set('token', j.token);",
              "} catch (e) {}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": {
          "raw": "{{baseUrl}}/api/auth/signup",
          "host": ["{{baseUrl}}"],
          "path": ["api", "auth", "signup"]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Test User\",\n  \"email\": \"test@example.com\",\n  \"password\": \"Password123\"\n}"
        }
      }
    },
    {
      "name": "Signin",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "try {",
              "  var j = pm.response.json();",
              "  if (j.token) pm.collectionVariables.set('token', j.token);",
              "} catch (e) {}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": {
          "raw": "{{baseUrl}}/api/auth/signin",
          "host": ["{{baseUrl}}"],
          "path": ["api", "auth", "signin"]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"test@example.com\",\n  \"password\": \"Password123\"\n}"
        }
      }
    },
    {
      "name": "Create agency (form-data)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "try {",
              "  var j = pm.response.json();",
              "  if (j.agency && j.agency.id) pm.collectionVariables.set('agencyId', j.agency.id);",
              "} catch (e) {}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}", "type": "text" }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/agency",
          "host": ["{{baseUrl}}"],
          "path": ["api", "agency"]
        },
        "body": {
          "mode": "formdata",
          "formdata": [
            { "key": "name", "value": "My Agency", "type": "text" },
            { "key": "companyEmail", "value": "contact@myagency.com", "type": "text" },
            { "key": "companyPhone", "value": "+15551234567", "type": "text" },
            { "key": "address", "value": "123 Main Street Suite 100", "type": "text" },
            { "key": "city", "value": "Kathmandu", "type": "text" },
            { "key": "state", "value": "Bagmati", "type": "text" },
            { "key": "zipCode", "value": "44600", "type": "text" },
            { "key": "country", "value": "Nepal", "type": "text" },
            {
              "key": "agencyLogo",
              "value": "https://api.dicebear.com/7.x/initials/svg?seed=Agency",
              "type": "text"
            },
            { "key": "whiteLabel", "value": "true", "type": "text" },
            { "key": "goal", "value": "5", "type": "text" }
          ]
        },
        "description": "Run after Signin. Same fields as agency settings UI. agencyLogo must be a URL string (not a file upload)."
      }
    },
    {
      "name": "Me (Get current user)",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}", "type": "text" }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/auth/me",
          "host": ["{{baseUrl}}"],
          "path": ["api", "auth", "me"]
        }
      }
    },
    {
      "name": "Forgot password",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": {
          "raw": "{{baseUrl}}/api/auth/forgot-password",
          "host": ["{{baseUrl}}"],
          "path": ["api", "auth", "forgot-password"]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"test@example.com\"\n}"
        }
      }
    },
    {
      "name": "Verify OTP",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": {
          "raw": "{{baseUrl}}/api/auth/verify-otp",
          "host": ["{{baseUrl}}"],
          "path": ["api", "auth", "verify-otp"]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"test@example.com\",\n  \"otp\": \"123456\"\n}"
        },
        "description": "Use OTP from email after forgot-password. Response includes resetToken for Reset password."
      }
    },
    {
      "name": "Reset password",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": {
          "raw": "{{baseUrl}}/api/auth/reset-password",
          "host": ["{{baseUrl}}"],
          "path": ["api", "auth", "reset-password"]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"token\": \"PASTE_resetToken_FROM_VERIFY_OTP\",\n  \"password\": \"NewPassword123\"\n}"
        }
      }
    }
  ]
}
