      "name": "Sprint 1 — Authentication & access",
      "item": [
        {
          "name": "1.1 Signup",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/signup",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "signup"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"API User\",\n  \"email\": \"apiuser@example.com\",\n  \"password\": \"Password123\"\n}"
            },
            "description": "Expect **201** + `token` when DB is up. Change email if user already exists (then **409**)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "try {",
                  "  var j = pm.response.json();",
                  "  if (j.token) pm.collectionVariables.set('token', j.token);",
                  "} catch (e) {}",
                  "pm.test('Signup returns 201 or 409', () => pm.expect([201,409]).to.include(pm.response.code));"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
